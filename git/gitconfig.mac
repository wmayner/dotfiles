# Mac-only git settings. install.sh links this file to ~/.gitconfig.local on
# macOS, and gitconfig includes that path at the end. Remote Linux boxes have
# no 1Password app to sign with and no general GitHub key, so they leave it out.
[user]
    signingkey = ssh-rsa 
[gpg]
    program = gpg
    format = ssh
[commit]
    gpgsign = true
[url "git@github.com:"]
    insteadOf = https://github.com/
[gpg "ssh"]
    program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
    allowedSignersFile = ~/dotfiles/git/allowed_signers
