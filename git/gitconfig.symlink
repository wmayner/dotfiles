[alias]
    a = commit --amend
    addon = commit --amend --no-edit
    co = checkout
    b = branch
    ba = branch -a
    c = commit -m
    com = commit -m
    ca = commit -am
    d = diff
    wd = diff --word-diff
    dc = diff --cached
    g = log --graph
    gr = log --graph --pretty=oneline --abbrev-commit
    l = log --graph --date-order --full-history --date=relative --color --pretty=format:"%x1b[31m%h%x09%x1b[32m%d%x1b[0m%x20%s%x20%x1b[33m(%an)%x1b[32m%x20%ad%x1b[0m"
    la = log --all --graph --date-order --full-history --date=relative --color --pretty=format:"%x1b[31m%h%x09%x1b[32m%d%x1b[0m%x20%s%x20%x1b[33m(%an)%x1b[32m%x20%ad%x1b[0m"
    s = status
    mt = mergetool
    unstage = reset HEAD --
    undo = reset --soft HEAD^
    nuke = reset --hard HEAD^
    blast = reset --hard HEAD
    amend = commit --amend -C HEAD
    contrib = shortlog -sn
    untrack = update-index --assume-unchanged
    track = update-index --no-assume-unchanged
    cp = cherry-pick
    # Alternative to stash:
    #   2. Create a branch named “foobar”
    #   2. Commit any changes on that branch
    #   3. Swap you back to the branch you started on
    save = !sh -c 'export PREV=$(git symbolic-ref HEAD|cut -d/ -f3-) && git checkout -b "$1" && git commit -am "$1" && git checkout "$PREV"' -
[color]
    ui = 1
[color "branch"]
    current = cyan
    local = green
    remote = yellow
[color "diff"]
    meta = cyan reverse
    frag = reverse
    old = red
    new = green
[color "status"]
    added = green
    untracked = cyan
    changed = yellow
[user]
    name = Will Mayner
    email = wmayner@gmail.com
    signingkey = ssh-rsa 
[core]
    excludesfile = ~/.gitignore
    autocrlf = input
    pager = delta
[credential]
    helper = cache --timeout=3600
[merge]
    tool = code
    conflictstyle = zdiff3
[mergetool "code"]
    cmd = code --wait --merge $REMOTE $LOCAL $BASE $MERGED
[push]
    default = current
    autoSetupRemote = true
[help]
    autocorrect = 0
[rerere]
    enabled = 1
[diff]
    tool = vimdiff
    algorithm = histogram
    colorMoved = default
[interactive]
    diffFilter = delta --color-only
[delta]
    navigate = true    # use n and N to move between diff sections
    line-numbers = true
    side-by-side = false
    syntax-theme = gruvbox-dark
[filter "media"]
    clean = git-media-clean %f
    smudge = git-media-smudge %f
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	required = true
	process = git-lfs filter-process
[pull]
    ff = only
[fetch]
    prune = true
[rebase]
    autosquash = true
    autostash = true
[gpg]
    program = gpg
    format = ssh
[commit]
    gpgsign = false
[difftool]
    prompt = false
[mergetool]
    prompt = false
[init]
    defaultBranch = main
[url "git@github.com:"]
    insteadOf = https://github.com/
[diff "jupyternotebook"]
    command = git-nbdiffdriver diff
[merge "jupyternotebook"]
    driver = git-nbmergedriver merge %O %A %B %L %P
    name = jupyter notebook merge driver
[difftool "nbdime"]
    cmd = git-nbdifftool diff \"$LOCAL\" \"$REMOTE\" \"$BASE\"
[mergetool "nbdime"]
    cmd = git-nbmergetool merge \"$BASE\" \"$LOCAL\" \"$REMOTE\" \"$MERGED\"
[gpg "ssh"]
    program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
