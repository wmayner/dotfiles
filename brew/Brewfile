# Brewfile

## To install:
# brew bundle install
# Later, to clean anything installed but not in Brewfile:
# brew bundle cleanup --force

# --- Formulae ---
brew "act"          # run GitHub Actions locally
brew "asdf"         # runtime version manager (e.g. Go)
brew "atuin"        # searchable, syncable shell history
brew "awscli"
brew "bat"          # cat replacement with syntax highlighting
brew "biber"        # biblatex backend
brew "cmake"
brew "colordiff"
brew "coreutils"
brew "direnv"
brew "docker"       # CLI only
brew "dust"         # du replacement
brew "eza"          # modern ls (exa successor)
brew "exiftool"
brew "fd"           # find replacement
brew "ffmpeg"
brew "fzf"
brew "git"
brew "gh"
brew "git-filter-repo"
brew "git-delta"    # beautiful git diffs
brew "git-lfs"      # Hugging Face model repos; gitconfig's lfs filter needs it
brew "gnupg"
brew "hf"           # Hugging Face CLI
brew "jq"           # JSON processor
brew "just"
brew "latexdiff"
brew "latexindent"  # VS Code formats LaTeX with it
brew "mosh"         # resilient SSH for flaky/roaming connections
brew "nbdime"       # notebook diff/merge drivers referenced in gitconfig
brew "ncdu"
brew "node"
brew "pandoc"
brew "pinentry-mac"
brew "poppler"      # pdftotext, pdfinfo, pdftoppm
brew "postgresql@18" # psql, for `railway connect`
brew "qrencode"
brew "railway"
brew "ripgrep"
brew "rsync"
brew "rclone"
brew "starship"     # modern shell prompt
brew "texlive"
brew "tmux"
brew "trash"
brew "tree"
brew "watch"
brew "wget"
brew "zoxide"
brew "zsh-history-substring-search"  # ^K/^J inline history scrolling

