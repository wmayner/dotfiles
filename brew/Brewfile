# Brewfile

## To install:
# brew bundle install
# Later, to clean anything installed but not in Brewfile:
# brew bundle cleanup --force

# --- Formulae ---
brew "asdf"         # runtime version manager (e.g. Go)
brew "atuin"        # searchable, syncable shell history
brew "bat"          # cat replacement with syntax highlighting
brew "cmake"
brew "colordiff"
brew "coreutils"
brew "direnv"
brew "dust"         # du replacement
brew "eza"          # modern ls (exa successor)
brew "fd"           # find replacement
brew "fzf"
brew "git"
brew "gh"
brew "git-delta"    # beautiful git diffs
brew "git-absorb"   # auto-fold WIP changes into the right ancestor commit
brew "gnupg"
brew "jq"           # JSON processor
brew "just"
brew "lazygit"      # git TUI
brew "mosh"         # resilient SSH for flaky/roaming connections
brew "node"
brew "pandoc"
brew "pinentry-mac"
brew "pipx"
brew "ripgrep"
brew "rsync"
brew "rclone"
brew "starship"     # modern shell prompt
brew "texlive"
brew "tmux"
brew "trash"
brew "tree"
brew "watch"
brew "wget"
brew "yq"           # YAML/JSON/XML processor (jq for YAML)
brew "zoxide"

