#!/bin/sh
# Short name for this machine, used by zshrc ($MACHINE_NAME, the tmux status
# bar) and the Claude status line. The starship prompt has the same names under
# [hostname] aliases.
h=$(hostname -s)
case $h in
  cluster-host-1) echo mats ;;
  cluster-host-2) echo mats-dev ;;
  *) echo "$h" ;;
esac
