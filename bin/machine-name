#!/bin/sh
# Short name for this machine, used by zshrc ($MACHINE_NAME, the tmux status
# bar and the starship prompt) and the Claude status line. Opaque hostnames get
# readable names from the private dotfiles' machine-names file, one
# "hostname name" per line, when that clone is present.
h=$(hostname -s)
map=$HOME/dotfiles-private/machine-names
if [ -r "$map" ]; then
  n=$(awk -v h="$h" '$1 == h { print $2; exit }' "$map")
  [ -n "$n" ] && h=$n
fi
echo "$h"
