#!/bin/zsh
#
# Forwards bin/clip-serve's socket to a remote machine, so remote/xclip there
# can paste the Mac's clipboard images into Claude Code. ~/.ssh/config runs it
# in the background whenever a new master connection opens:
#   PermitLocalCommand yes
#   LocalCommand ~/dotfiles/bin/clip-forward %n </dev/null >/dev/null 2>&1 &
# A RemoteForward line would stop working after the first disconnect: sshd
# leaves the socket file behind and refuses to bind over it. So this has the
# remote delete a dead socket first, then adds the forward to the master.
host=$1
local_sock=/tmp/com.wmayner.clip-serve.sock  # SockPathName in macos/com.wmayner.clip-serve.plist

# The master serves other sessions only once LocalCommand has returned.
for i in {1..20}; do
  ssh -O check "$host" 2>/dev/null && break
  (( i == 20 )) && exit 1
  sleep 0.5
done
remote_sock=$(ssh -o PermitLocalCommand=no "$host" '~/.local/bin/xclip --check') && exit 0
[[ -n $remote_sock ]] && ssh -O forward -R "$remote_sock:$local_sock" "$host"
