#!/bin/sh
#
# Update system packages, language tooling, vim plugins, and oh-my-zsh.

# System package manager
if [ "$(uname -s)" = "Darwin" ]; then
  brew upgrade && brew cleanup
else
  sudo apt-get update && sudo apt-get upgrade -y
fi

# uv: primary Python tooling
command -v uv >/dev/null 2>&1 && uv self update

# Global npm packages
command -v npm >/dev/null 2>&1 && npm update -g

# vim-plug and plugins
command -v vim >/dev/null 2>&1 && vim +PlugUpgrade +PlugUpdate +PlugInstall! +PlugClean! +qa

# oh-my-zsh
zsh -ic 'omz update'
