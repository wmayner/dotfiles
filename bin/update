#!/bin/sh
#
# Update the dotfiles, system packages, language tooling, Claude Code, and vim
# plugins.
#
# Steps are independent: a failure in one does not stop the rest, but every
# failure is collected and reported at the end, and the script exits non-zero.
# Without that, a failed `brew upgrade` just scrolls past.

failed=''
fail() { failed="${failed}${failed:+, }$1"; }

DOTFILES="$(cd "$(dirname "$0")/.." && pwd)"

# The dotfiles themselves. The repo is public, so fetch over https without the
# global config, whose Mac part rewrites GitHub URLs to SSH through 1Password;
# its approval prompt would block the daily run. --ff-only: a diverged main is
# reported, not merged.
GIT_CONFIG_GLOBAL=/dev/null git -C "$DOTFILES" fetch https://github.com/wmayner/dotfiles.git main:refs/remotes/origin/main \
  && git -C "$DOTFILES" merge --ff-only origin/main \
  && GIT_CONFIG_GLOBAL=/dev/null git -C "$DOTFILES" submodule update --init \
  || fail dotfiles

# System package manager
if [ "$(uname -s)" = "Darwin" ]; then
  # Install anything added to the Brewfile since this machine last ran it.
  brew bundle install --no-upgrade --file="$DOTFILES/brew/Brewfile" || fail 'brew bundle'
  # Note: plain `brew upgrade` skips casks that update themselves (currently
  # hammerspoon). Add --greedy if you want those too, but it can
  # fight an app's own updater.
  # --yes: Homebrew now asks for confirmation before upgrading by default.
  brew upgrade --yes && brew cleanup || fail brew
elif command -v pixi >/dev/null 2>&1; then
  # No-root machines (the MATS nodes; see remote/bootstrap-noroot.sh): there is
  # no sudo, and the command-line tools come from conda-forge through pixi.
  pixi global update || fail pixi
  if command -v claude-history >/dev/null 2>&1; then
    claude-history update || fail claude-history
  fi
else
  SUDO=''; [ "$(id -u)" -eq 0 ] || SUDO=sudo  # GPU boxes run as root, often without sudo
  $SUDO apt-get update && $SUDO apt-get upgrade -y || fail apt
fi

# asdf plugins (the runtime versions themselves stay pinned in .tool-versions)
if command -v asdf >/dev/null 2>&1; then
  asdf plugin update --all || fail asdf
fi

# uv: primary Python tooling
if command -v uv >/dev/null 2>&1; then
  uv self update || fail uv
  uv tool upgrade --all || fail 'uv tools'
  uv python upgrade || fail 'uv python'
fi

# Global npm packages
if command -v npm >/dev/null 2>&1; then
  npm update -g || fail npm
fi

# Claude Code and its plugins. autoUpdates is off in ~/.claude.json, and only
# some marketplaces set autoUpdate, so nothing else keeps these current.
# Project-scoped plugins are left to their projects.
if command -v claude >/dev/null 2>&1; then
  # Mods added to claude/ and changes to the shared settings
  sh "$DOTFILES/claude/link.sh" || fail 'claude config'
  claude update || fail claude
  # Marketplaces and plugins are git clones of public GitHub repos; skip the
  # global config for the same reason as the dotfiles fetch above.
  GIT_CONFIG_GLOBAL=/dev/null claude plugin marketplace update || fail 'claude marketplaces'
  for p in $(claude plugin list --json | jq -r '.[] | select(.scope == "user") | .id | select(endswith("@skills-dir") | not)'); do
    GIT_CONFIG_GLOBAL=/dev/null claude plugin update "$p" || fail "claude plugin $p"
  done
fi

# vim-plug and plugins. These live under ~/.vim/plugged, which is a symlink
# into ~/.config/nvim/ for historical reasons -- it is vim's plugin dir, not
# neovim's. `+PlugUpdate` at startup implies --sync (vim-plug treats
# has('vim_starting') as synchronous), so +qa cannot race the updates.
if command -v vim >/dev/null 2>&1; then
  # Its screen drawing is noise, and fills the log on the daily run.
  vim +PlugUpgrade +PlugUpdate +PlugInstall! +PlugClean! +qa >/dev/null || fail vim
fi

if [ -n "$failed" ]; then
  printf '\nupdate: FAILED: %s\n' "$failed" >&2
  exit 1
fi
printf '\nupdate: all steps completed\n'
