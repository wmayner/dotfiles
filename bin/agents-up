#!/usr/bin/env bash
#
# Run Claude Code's Remote Control server in a tmux session named "agents", one
# window per project, so sessions can be started and watched from the Claude
# app. Run it again after the machine reboots; windows that already exist are
# left alone, and then it attaches.
#
#   agents-up [dir[:mode] ...]
#
# mode is how the server starts sessions: worktree (the default; each session
# gets its own git worktree, so concurrent agents do not edit the same checkout)
# or same-dir (all sessions work in dir itself).
[ $# -eq 0 ] && set -- "$HOME/mats-research" "$HOME/reading:same-dir"
for arg in "$@"; do
  dir=${arg%%:*}; mode=worktree; [ "$arg" != "$dir" ] && mode=${arg#*:}
  # API keys (vast.ai, RunPod, ...) are loaded inside the window: agents-up runs
  # over ssh without zsh's startup files, and a new tmux window does not inherit
  # this script's environment. Sessions started from the app inherit the
  # server's environment, and so does the background daemon when one of them
  # launches it. The server exits after ~10 minutes without network; start it
  # again.
  # Claude Code's scratchpads go on the local /ephemeral disk, not /tmp, which shares the small root disk.
  # ANTHROPIC_API_KEY and ANTHROPIC_AUTH_TOKEN are unset after loading the secrets: if Claude Code finds
  # either one in its environment, it bills the API instead of the Claude subscription. Code that needs
  # an Anthropic key reads it from its own secrets file (persona-neurons does) or uses ANTHROPIC_API_KEY_MATS.
  server="set -a; for f in ~/.config/*/secrets.env; do . \"\$f\"; done; set +a
unset ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN
[ -d /ephemeral ] && export CLAUDE_CODE_TMPDIR=/ephemeral/\$USER/claude-tmp && mkdir -p \"\$CLAUDE_CODE_TMPDIR\"
while :; do claude remote-control --spawn $mode; echo 'restarting in 30s'; sleep 30; done"
  [ -d "$dir" ] || { echo "agents-up: no such directory: $dir" >&2; continue; }
  name=$(basename "$dir")
  if ! tmux has-session -t agents 2>/dev/null; then
    tmux new-session -d -s agents -n "$name" -c "$dir" "$server"
  elif ! tmux list-windows -t agents -F '#W' | grep -qx "$name"; then
    tmux new-window -d -t agents -n "$name" -c "$dir" "$server"
  fi
done
[ -t 1 ] && exec tmux attach -t agents
