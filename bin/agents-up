#!/usr/bin/env bash
#
# Run Claude Code's Remote Control server in a tmux session named "agents", so
# sessions can be started and watched from the Claude app. Run it again after
# the machine reboots; if the session already exists it just attaches.
#
#   agents-up [dir]    (default: ~/mats-research)
#
# Each session the app starts gets its own git worktree, so concurrent agents
# do not edit the same checkout.
dir=${1:-$HOME/mats-research}
if ! tmux has-session -t agents 2>/dev/null; then
  # The server exits after ~10 minutes without network; start it again.
  tmux new-session -d -s agents -c "$dir" \
    'while :; do claude remote-control --spawn worktree; echo "restarting in 30s"; sleep 30; done'
fi
[ -t 1 ] && exec tmux attach -t agents
