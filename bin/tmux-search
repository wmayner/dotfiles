#!/usr/bin/env python3
"""Find a tmux window by name, or search the conversations of the Claude Code sessions in tmux,
and jump to one.

Bound to prefix + / in tmux.conf, as a popup. It opens matching window names: type part of a
session name, tmux window name or number, and fzf narrows the list as you type. The preview
shows the end of the selected window's conversation. Ctrl-s switches to searching the
conversations themselves: windows whose name contains the text come first (exact names, then
names that start with it, then the rest), with the match highlighted; then each window whose
conversation has lines containing it, with how many. The preview then shows those lines,
newest at the bottom. Ctrl-s again goes back to names. Enter switches to that window; Esc
closes the popup. Conversation search is literal and ignores case unless the text has a
capital letter.

Opening the popup reads no transcripts, only tmux's window list and Claude Code's small session
files, so it appears at once even when the shared disk is slow. Transcripts are read when the
preview needs one, and all of them when Ctrl-s first switches to conversation search.

Claude Code draws on the terminal's alternate screen, so tmux keeps no scrollback for it.
Instead this reads each session's transcript, found through the registry Claude Code keeps
in <config dir>/sessions/<pid>.json (the session's tmux pane and id), for every config dir
(~/.claude, ~/.claude-2, ...). Only the conversation is searched: the messages typed to the
session and Claude's replies, not tool calls or their output. Panes without a Claude
session (shells, other programs) are searched by their screen and scrollback.

The text taken from each transcript is cached (under /ephemeral/$USER/cache where that
exists, else ~/.cache) and extended as the transcript grows, so only the first read of a
transcript reads all of it. Times are Pacific.

Usage: tmux-search [popup [CLIENT]]     the popup; Enter moves tmux client CLIENT (tmux.conf
                                       passes the one that opened the popup)
       tmux-search index               build the index, read every window's text, print it
       tmux-search list INDEX QUERY    one line per matching window (conversation search)
       tmux-search show INDEX PANE QUERY   matching lines of one window (the preview)
       tmux-search toggle INDEX        fzf actions that switch between names and conversations
"""
import fcntl
import glob
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
from datetime import datetime

try:
    from zoneinfo import ZoneInfo
    TZ = ZoneInfo("America/Los_Angeles")
except Exception:  # very old Python: show the transcript's UTC times
    TZ = None

HOME = os.path.expanduser("~")
USER = os.environ.get("USER", "")
_eph = f"/ephemeral/{USER}"
CACHE = os.path.join(os.path.join(_eph, "cache") if USER and os.path.isdir(_eph)
                     else os.environ.get("XDG_CACHE_HOME", os.path.join(HOME, ".cache")),
                     "tmux-search")
SELF = os.path.realpath(__file__)
ME = f"{shlex.quote(sys.executable)} {shlex.quote(SELF)}"

NAME_PROMPT, TEXT_PROMPT = "name> ", "text> "
HEADER = "Enter: go to the window   Esc: close\nCtrl-s: switch between names and text"

# Wrappers Claude Code puts around text that wasn't typed as a message.
DROP_TAGS = re.compile(r"<(system-reminder|local-command-caveat|local-command-stdout|"
                       r"command-message|command-args|task-notification|bash-stdout|"
                       r"bash-stderr)>.*?</\1>", re.S)
TAGS = re.compile(r"</?(pasted_content|command-name|bash-input)[^>]*>")


def tmux(*args):
    return subprocess.run(["tmux", *args], capture_output=True, text=True).stdout


def stamp(iso):
    try:
        dt = datetime.fromisoformat(iso.replace("Z", "+00:00"))
    except Exception:
        return "?"
    if TZ:
        dt = dt.astimezone(TZ)
    return f"{dt:%b} {dt.day} {dt:%H:%M}"


def entry_lines(o):
    """The conversation lines of one transcript entry, as 'time who: text'."""
    kind = o.get("type")
    if kind not in ("user", "assistant") or o.get("isMeta") or o.get("isCompactSummary") \
            or o.get("isSidechain"):
        return []
    content = (o.get("message") or {}).get("content")
    if isinstance(content, str):
        texts = [content]
    elif isinstance(content, list):
        texts = [b.get("text", "") for b in content if isinstance(b, dict) and b.get("type") == "text"]
    else:
        return []
    who = "user" if kind == "user" else "claude"
    ts = stamp(o.get("timestamp", ""))
    out = []
    for t in texts:
        if kind == "user":
            t = TAGS.sub("", DROP_TAGS.sub("", t))
        for line in t.splitlines():
            line = line.strip()
            if line:
                out.append(f"{ts} {who}: {line}\n")
    return out


def transcript_text(path, sid):
    """Bring the cached conversation text of one transcript up to date; return its path."""
    # <sid>.offset holds how far the transcript has been read and how long the text was then.
    # fzf kills a preview or search that is still running when the selection or query changes;
    # text appended after the last saved offset is dropped on the next run, not duplicated.
    txt, off = os.path.join(CACHE, f"{sid}.txt"), os.path.join(CACHE, f"{sid}.offset")
    with open(os.path.join(CACHE, f"{sid}.lock"), "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        try:
            saved = [int(v) for v in open(off).read().split()]
        except Exception:
            saved = []
        have = os.path.getsize(txt) if os.path.exists(txt) else None
        pos = saved[0] if saved and have is not None else 0
        keep = saved[1] if len(saved) > 1 else (have or 0)  # older caches saved only the offset
        size = os.path.getsize(path)
        if pos > size or have is None or keep > have:  # transcript rewritten, or cache lost
            pos = keep = 0
        if pos < size or keep != have:
            with open(txt, "a") as out:
                out.truncate(keep)
                with open(path, "rb") as f:
                    f.seek(pos)
                    for raw in f:
                        if not raw.endswith(b"\n"):  # a line still being written
                            break
                        pos += len(raw)
                        if len(raw) > 20000 and b'"tool_result"' in raw:  # skip big tool output unparsed
                            continue
                        try:
                            out.writelines(entry_lines(json.loads(raw)))
                        except Exception:
                            pass
            tmp = f"{off}.{os.getpid()}.tmp"
            with open(tmp, "w") as f:
                f.write(f"{pos} {os.path.getsize(txt)}")
            os.replace(tmp, off)
    return txt


def claude_sessions():
    """Live Claude Code sessions in tmux: {pane id: (session name, config dir, session id, updated)}.

    Reads only the small registry files, not the transcripts."""
    dirs = {os.path.realpath(d) for d in glob.glob(os.path.join(HOME, ".claude*"))
            if os.path.isdir(os.path.join(d, "sessions"))}
    if os.environ.get("CLAUDE_CONFIG_DIR"):
        dirs.add(os.path.realpath(os.environ["CLAUDE_CONFIG_DIR"]))
    found = {}
    for cfg in dirs:
        for f in glob.glob(os.path.join(cfg, "sessions", "*.json")):
            try:
                d = json.load(open(f))
                os.kill(int(d["pid"]), 0)
            except Exception:
                continue
            target, sid = d.get("tmux") or "", d.get("sessionId")
            if ".%" not in target or not sid:
                continue
            pane = "%" + target.rsplit(".%", 1)[1]
            updated = d.get("updatedAt") or 0
            if pane not in found or updated > found[pane][3]:
                found[pane] = (d.get("name") or "", cfg, sid, updated)
    return found


# An index row: pane id, label, path of the window's text ("" until read), names joined by
# \x1f, Claude config dir and session id ("" for panes without a Claude session).
def build_index(path):
    """One row per tmux window (per pane, if it has several), from names alone."""
    os.makedirs(CACHE, exist_ok=True)
    sessions = claude_sessions()
    rows = []
    fmt = "#{pane_id}\t#{session_name}:#{window_index}\t#{window_name}\t#{pane_index}\t#{window_panes}"
    for line in tmux("list-panes", "-a", "-F", fmt).splitlines():
        pane, target, wname, pidx, npanes = line.split("\t")
        if npanes != "1":
            target += f".{pidx}"
        name, cfg, sid, _ = sessions.get(pane, ("", "", "", 0))
        number = target.split(":")[-1].split(".")[0]
        names = "\x1f".join([target, number, name, wname])
        rows.append([pane, f"{target:<12} {name or wname}", "", names, cfg, sid])
    write_index(path, rows)
    return rows


def write_index(path, rows):
    tmp = f"{path}.{os.getpid()}.tmp"
    with open(tmp, "w") as f:
        f.writelines("\t".join(r) + "\n" for r in rows)
    os.replace(tmp, path)


def read_index(path):
    return [line.rstrip("\n").split("\t") for line in open(path)]


def refresh(row):
    """Bring one window's searchable text up to date; return the path of that text."""
    pane, _, _, _, cfg, sid = row
    found = glob.glob(os.path.join(cfg, "projects", "*", f"{sid}.jsonl")) if sid else []
    if found:
        return transcript_text(found[0], sid)
    txt = os.path.join(CACHE, f"pane-{pane.lstrip('%')}.txt")
    tmp = f"{txt}.{os.getpid()}.tmp"  # replaced whole, so a preview never reads it half written
    with open(tmp, "w") as f:
        f.write(tmux("capture-pane", "-p", "-J", "-S", "-", "-t", pane).rstrip() + "\n")  # no blank screen rows
    os.replace(tmp, txt)
    return txt


def ensure_text(index):
    """Conversation search needs every window's text: read them all, once per popup."""
    rows = read_index(index)
    if not all(r[2] for r in rows):
        for r in rows:
            r[2] = refresh(r)
        write_index(index, rows)
    return rows


def grep_flags(query):
    return ["-F"] + (["-i"] if query == query.lower() else [])


def name_rank(names, q, fold):
    """0 if one of a window's names is the query, 1 if one starts with it, 2 if one contains it, else None."""
    best = None
    for n in names.split("\x1f"):
        n = fold(n).lstrip("✳ ").strip()  # Claude Code marks a busy session's window title with ✳
        if n and q in n:
            r = 0 if n == q else 1 if n.startswith(q) else 2
            best = r if best is None else min(best, r)
    return best


def cmd_list(index, query):
    if not query:
        for pane, label, *_ in read_index(index):
            print(f"{pane}\t{label}")
        return
    rows = ensure_text(index)
    files = [r[2] for r in rows]
    res = subprocess.run(["grep", "-c", "-H", *grep_flags(query), "-e", query, "--", *files],
                         capture_output=True, text=True).stdout
    counts = {}
    for line in res.splitlines():
        f, _, n = line.rpartition(":")
        counts[f] = int(n) if n.isdigit() else 0
    fold = str.lower if query == query.lower() else (lambda x: x)  # same case rule as grep
    q = fold(query)
    ranks = {r[0]: name_rank(r[3], q, fold) for r in rows}
    by_name = sorted((r for r in rows if ranks[r[0]] is not None), key=lambda r: ranks[r[0]])
    by_text = sorted((r for r in rows if ranks[r[0]] is None and counts.get(r[2], 0)),
                     key=lambda r: -counts[r[2]])
    for pane, label, txt, *_ in by_name + by_text:
        n = counts.get(txt, 0)
        label = f"{label:<44}"
        i = fold(label).find(q)
        if i >= 0:  # highlight a name match, as fzf would
            label = f"{label[:i]}\033[1;33m{label[i:i + len(q)]}\033[0m{label[i + len(q):]}"
        print(f"{pane}\t{label} {n or '':>5}")


def cmd_show(index, pane, query):
    row = next((r for r in read_index(index) if r[0] == pane), None)
    if not row:
        return
    txt = row[2] or refresh(row)
    lines = []
    if query:
        env = dict(os.environ, GREP_COLORS="ms=01;33:ne")  # yellow matches, no line-clearing codes
        res = subprocess.run(["grep", *grep_flags(query), "--color=always", "-e", query, "--", txt],
                             capture_output=True, text=True, env=env).stdout
        lines = res.splitlines()[-400:]
    if not lines:  # no query, or a window found by its name whose conversation lacks the text
        with open(txt, errors="replace") as f:
            lines = f.read().splitlines()[-200:]
    print("\n".join(lines))


def cmd_toggle(index):
    """Print the fzf actions for Ctrl-s (a transform binding; fzf sets $FZF_PROMPT)."""
    ix = shlex.quote(index)
    if os.environ.get("FZF_PROMPT") == TEXT_PROMPT:
        print(f"enable-search+change-prompt({NAME_PROMPT})"
              f"+unbind(change)+change-preview({ME} show {ix} {{1}} '')+reload({ME} list {ix} '')")
    else:
        print(f"disable-search+change-prompt({TEXT_PROMPT})"
              f"+rebind(change)+change-preview({ME} show {ix} {{1}} {{q}})"
              f"+reload({ME} list {ix} {{q}})")


def popup(client=None):
    fzf = shutil.which("fzf") or next((p for p in (f"{HOME}/.pixi/bin/fzf", "/opt/homebrew/bin/fzf",
                                                   "/usr/local/bin/fzf") if os.path.exists(p)), None)
    if not fzf:
        sys.exit("tmux-search needs fzf")
    index = os.path.join(CACHE, f"index-{os.getpid()}.tsv")
    ix = shlex.quote(index)
    try:
        rows = build_index(index)
        sel = subprocess.run(
            [fzf, "--ansi", "--delimiter", "\t", "--with-nth", "2",
             "--prompt", NAME_PROMPT, "--header", HEADER,
             "--bind", f"change:reload:{ME} list {ix} {{q}}",  # used only in conversation search
             "--bind", "start:unbind(change)",
             "--bind", f"ctrl-s:transform:{ME} toggle {ix}",
             "--preview", f"{ME} show {ix} {{1}} ''",
             "--preview-window", "right,60%,wrap,follow"],
            input="".join(f"{r[0]}\t{r[1]}\n" for r in rows),
            stdout=subprocess.PIPE, text=True).stdout
    finally:
        try:
            os.remove(index)
        except OSError:
            pass
    pane = sel.split("\t", 1)[0].strip() if sel else ""
    if pane.startswith("%"):
        # Without -c, switch-client moves the client used most recently, which may be
        # another terminal attached to the same server.
        switch = ["switch-client"] + (["-c", client] if client else []) + ["-t", pane]
        subprocess.run(["tmux", "select-window", "-t", pane, ";", "select-pane", "-t", pane,
                        ";", *switch])


def main():
    args = sys.argv[1:]
    if not args:
        popup()
    elif args[0] == "popup" and len(args) <= 2:
        popup(args[1] if len(args) == 2 else None)
    elif args[0] == "index":
        path = os.path.join(CACHE, "index-test.tsv")
        build_index(path)
        for pane, label, txt, *_ in ensure_text(path):
            print(f"{pane}\t{label}\t{os.path.getsize(txt)} bytes")
    elif args[0] == "list" and len(args) == 3:
        cmd_list(args[1], args[2])
    elif args[0] == "show" and len(args) == 4:
        cmd_show(args[1], args[2], args[3])
    elif args[0] == "toggle" and len(args) == 2:
        cmd_toggle(args[1])
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main()
