{
  "remoteControlAtStartup": true,
  "permissions": {
    "deny": [
      "Bash(sudo *)",
      "Bash(rm -rf /)",
      "Bash(shutdown *)",
      "Bash(reboot *)"
    ],
    "ask": [
      "Bash(git reset --hard*)",
      "Bash(git checkout .)",
      "Bash(git checkout -- *)",
      "Bash(git checkout -f*)",
      "Bash(git restore .)",
      "Bash(git clean *)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git branch -D *)",
      "Bash(git rebase *)",
      "Bash(git stash drop *)",
      "Bash(git stash clear*)",
      "Bash(git push --delete *)",
      "Bash(git commit --amend*)"
    ],
    "defaultMode": "auto"
  },
  "extraKnownMarketplaces": {
    "iit-expert": {
      "source": {
        "source": "github",
        "repo": "wmayner/iit-expert-plugin"
      },
      "autoUpdate": true
    },
    "alignment-hive": {
      "source": {
        "source": "git",
        "url": "https://github.com/Crazytieguy/alignment-hive.git"
      }
    },
    "codex-plugin-cc": {
      "source": {
        "source": "github",
        "repo": "Crazytieguy/codex-plugin-cc"
      },
      "autoUpdate": true
    },
    "glance": {
      "source": {
        "source": "github",
        "repo": "wmayner/claude-glance"
      },
      "autoUpdate": true
    },
    "precis": {
      "source": {
        "source": "github",
        "repo": "Crazytieguy/precis"
      },
      "autoUpdate": true
    },
    "prepare-compact": {
      "source": {
        "source": "github",
        "repo": "wmayner/claude-prepare-compact"
      },
      "autoUpdate": true
    }
  },
  "enabledPlugins": {
    "code-review@claude-plugins-official": false,
    "code-simplifier@claude-plugins-official": false,
    "feature-dev@claude-plugins-official": false,
    "frontend-design@claude-plugins-official": false,
    "playwright@claude-plugins-official": false,
    "pyright-lsp@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "figma@claude-plugins-official": false,
    "iit-expert@iit-expert": true,
    "debrief@alignment-hive": true,
    "hive@alignment-hive": true,
    "mats@alignment-hive": true,
    "llms-fetch-mcp@alignment-hive": true,
    "tldr@alignment-hive": false,
    "codex@codex-plugin-cc": true,
    "data@synced": false,
    "finance@synced": false,
    "marketing@synced": false,
    "figma@synced": false,
    "cowork-plugin-management@synced": false,
    "glance@glance": true,
    "precis@precis": true,
    "prepare-compact@prepare-compact": true
  }
}
