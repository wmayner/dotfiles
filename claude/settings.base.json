{
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh",
    "refreshInterval": 60
  },
  "model": "opus",
  "effortLevel": "high",
  "tui": "fullscreen",
  "editorMode": "vim",
  "theme": "auto",
  "verbose": false,
  "autoCompactEnabled": false,
  "cleanupPeriodDays": 99999,
  "worktree": {
    "baseRef": "head"
  },
  "teammateMode": "auto",
  "env": {
    "CLAUDE_CODE_SCROLL_SPEED": "8",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  }
}
