# .zshrc of wmayner

# -----------------------------------------------------------------------------
# MUST BE FIRST
# -----------------------------------------------------------------------------
# Establish a minimal, known-good baseline PATH so core macOS tools are always
# available even if later initialization fails. Final PATH ordering is enforced
# near the end of the file.
export PATH="/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:/opt/homebrew/sbin"
hash -r

# -----------------------------------------------------------------------------
# Apple Silicon safety: force arm64 shell if launched under Rosetta
# -----------------------------------------------------------------------------
# Prevent accidentally running an x86_64 shell that would pick up Intel
# Homebrew artifacts. The guard variable prevents infinite recursion.
if [[ "$(uname -m)" == "x86_64" ]] && [[ "$(sysctl -n hw.optional.arm64 2>/dev/null)" == "1" ]] && [[ -z "${ZSH_FORCE_ARM64_DONE:-}" ]]; then
  export ZSH_FORCE_ARM64_DONE=1
  exec arch -arm64 /bin/zsh -l
fi

# -----------------------------------------------------------------------------
# XDG base directories
# -----------------------------------------------------------------------------
export XDG_CACHE_HOME="$HOME/.cache"

# -----------------------------------------------------------------------------
# Early, machine-specific overrides
# -----------------------------------------------------------------------------
# Put system-specific early logic in ~/.zshrc.before.local so this file
# remains portable.
[ -f "$HOME/.zshrc.before.local" ] && source "$HOME/.zshrc.before.local"
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Environment variables
# -----------------------------------------------------------------------------
# Default editor
export EDITOR="code --wait"
export VISUAL="code --wait"
export DOTFILES="$HOME/dotfiles"

# Secrets from the macOS keychain. Each `security` call is a 20-35ms round trip
# to the keychain daemon, so fetch them concurrently instead of in sequence
# (measured on this machine: 75ms sequential, 26ms parallel).
# A key that is not in the keychain is left unset rather than exported empty.
# To add one: security add-generic-password -a "$USER" -s HF_TOKEN -w
eval "$(for _k in VAST_API_KEY WANDB_API_KEY RAILWAY_TOKEN HF_TOKEN SLACK_DEPLOY_WEBHOOK; do
  { _v="$(security find-generic-password -s $_k -w 2>/dev/null)" && printf 'export %s=%q\n' $_k "$_v" } &
done; wait)"
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Custom completions
# -----------------------------------------------------------------------------
# Homebrew's site-functions holds _brew and the completions shipped by formulae.
# It was missing here, so `brew <TAB>` had never worked.
#
# ~/.docker/completions is here because Docker Desktop otherwise appends its own
# fpath+compinit block to the end of this file on update. That second compinit
# costs ~25ms. If Docker re-appends the block, delete it -- this line covers it.
fpath=(~/.zsh/completions /opt/homebrew/share/zsh/site-functions ~/.docker/completions $fpath)

# -----------------------------------------------------------------------------
# Completion
# -----------------------------------------------------------------------------
# This replaces oh-my-zsh, which cost ~80ms per shell. Only ~18ms of that was
# the four plugins we loaded (brew, git, history-substring-search, direnv); the
# rest was framework overhead: 25 library files, an unconditional compaudit, and
# a handful of forks (git rev-parse, scutil, grep, tee, mkdir, rm) to validate
# the completion dump. Across ~24k history entries we used exactly six aliases
# that oh-my-zsh provided and this file did not; they are reproduced below.
#
# Completions for git, brew, etc. come from zsh's own _git and from Homebrew's
# site-functions, both already on $fpath -- the plugins were not supplying them.

# extendedglob has to be on before the `(#q...)` test below. Without it that
# test is a plain non-empty string, so the full compinit ran on every startup.
setopt extendedglob
zmodload zsh/complist
autoload -Uz compinit

# Regenerate the dump at most once a day. On every other startup, `compinit -C`
# skips both the security audit and the staleness scan.
_zcompdump="$XDG_CACHE_HOME/zsh/zcompdump-$ZSH_VERSION"
[[ -d ${_zcompdump:h} ]] || mkdir -p ${_zcompdump:h}
if [[ -n $_zcompdump(#qN.mh+24) ]]; then
  compinit -d $_zcompdump
else
  compinit -C -d $_zcompdump
fi
# Compiled dumps load noticeably faster than the plain file.
if [[ ! -s ${_zcompdump}.zwc || ${_zcompdump} -nt ${_zcompdump}.zwc ]]; then
  zcompile -R -- ${_zcompdump}
fi
unset _zcompdump

zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}' 'r:|=*' 'l:|=* r:|=*'
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
zstyle ':completion:*' menu select
zstyle ':completion:*' use-cache yes
zstyle ':completion:*' cache-path "$XDG_CACHE_HOME/zsh/zcompcache"
zstyle ':completion:*:*:*:*:processes' command "ps -u $USER -o pid,user,comm -w -w"

# Installed a new completion and want it now rather than at the next daily
# refresh? Run this, then open a new shell.
alias rmcompdump='rm -f "$XDG_CACHE_HOME"/zsh/zcompdump-*'

# -----------------------------------------------------------------------------
# History
# -----------------------------------------------------------------------------
# atuin (below) holds the searchable record; this is the plain-file backup.
# oh-my-zsh set SAVEHIST=10000 against HISTSIZE=50000, which silently threw away
# 40k entries on exit.
HISTFILE="$HOME/.zsh_history"
HISTSIZE=50000
SAVEHIST=50000
setopt extended_history hist_expire_dups_first hist_ignore_dups \
       hist_ignore_space hist_verify inc_append_history share_history

# -----------------------------------------------------------------------------
# history-substring-search (bound to ^K/^J in the keybindings section)
# -----------------------------------------------------------------------------
source /opt/homebrew/share/zsh-history-substring-search/zsh-history-substring-search.zsh

# -----------------------------------------------------------------------------
# The oh-my-zsh aliases we actually used
# -----------------------------------------------------------------------------
alias grep='grep --color=auto --exclude-dir={.bzr,CVS,.git,.hg,.svn,.idea,.tox,.venv,venv}'
alias gst='git status'
alias la='ls -lAh'
alias -g ...='../..'
alias -g ....='../../..'
alias -g .....='../../../..'

# -----------------------------------------------------------------------------
# Tool configuration
# -----------------------------------------------------------------------------

# Bright highlight on matching history search
typeset -g HISTORY_SUBSTRING_SEARCH_HIGHLIGHT_FOUND='fg=#ffffff,bg=#aa00aa,bold'
# Leave highlight on
typeset -g HISTORY_SUBSTRING_SEARCH_HIGHLIGHT_TIMEOUT=99999

# gpg
export GPG_TTY=$TTY

# Homebrew
export HOMEBREW_NO_ANALYTICS=1

# LS_COLORS from our dircolors theme; eza reads it too. The `ls`/`dircolors`
# probes that used to be here forked three extra processes to set `ls` aliases
# that the eza block below overwrites anyway. `$+commands[...]` is a hash
# lookup, not a fork.
(( $+commands[gdircolors] )) && eval "$(gdircolors $DOTFILES/zsh/dircolors.ansi-dark)"
export LSCOLORS="Gxfxcxdxbxegedabagacad"  # BSD ls, used only if eza is absent
export GREP_COLORS='mt=1;31'

# less: syntax highlighting comes from bat (see the bat block below). The old
# LESSOPEN pointed at ~/.lessfilter, which shells out to pygmentize -- not
# installed, so every match failed and fell through to plain less anyway.

# zoxide with fzf-style fuzzy matching
eval "$(zoxide init zsh --no-cmd)"
z() {
  if [[ $# -eq 0 ]]; then
    builtin cd ~
  else
    local dir
    # Fuzzy-match only the last path component, rank by match quality, and
    # break ties by zoxide score (the list's input order).
    dir=$(zoxide query --list | fzf --filter "$*" --delimiter / --nth -1 --tiebreak=index | head -1) && builtin cd "$dir"
  fi
}
alias zi='__zoxide_zi'
alias j='z'
alias ji='zi'
# Print the dir `j` would jump to, for use in other commands
zq() {
    zoxide query --list | fzf --filter "$*" --delimiter / --nth -1 --tiebreak=index | head -1
}
alias jd='zq'  # not `jq`: that would hide the JSON tool

# iTerm integration
[ -f "$HOME/.iterm2_shell_integration.zsh" ] && source "$HOME/.iterm2_shell_integration.zsh"

# asdf: nothing to source. asdf 0.16+ (the Go rewrite) ships no asdf.sh; it
# works purely via its shims dir, which is on PATH (see FINAL PATH ASSEMBLY).

# fzf: Catppuccin Mocha color scheme
export FZF_DEFAULT_OPTS=" \
  --reverse \
  --color=bg+:#313244,bg:#1e1e2e,spinner:#f5e0dc,hl:#f38ba8 \
  --color=fg:#cdd6f4,header:#f38ba8,info:#cba6f7,pointer:#f5e0dc \
  --color=marker:#f5e0dc,fg+:#cdd6f4,prompt:#cba6f7,hl+:#f38ba8"

[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh

# atuin: searchable, syncable shell history. Use NOBIND so it does not hijack
# the arrow keys; we bind it to ^R explicitly in the keybindings section below
# (replacing the old ^X^R fzf history widget). ^K/^J keep inline substring
# scrolling. Sync is opt-in (`atuin login`); local history works out of the box.
if command -v atuin &>/dev/null; then
  export ATUIN_NOBIND=true
  eval "$(atuin init zsh)"
fi

# direnv: installs precmd/chpwd hooks, so .envrc files load on startup and on
# every directory change. Replaces the oh-my-zsh direnv plugin.
eval "$(direnv hook zsh)"

# pyphi
export PYPHI_WELCOME_OFF='yes'

# -----------------------------------------------------------------------------
# Keybindings / aliases
# -----------------------------------------------------------------------------

# Use vi to edit command line
bindkey -v

# Remove delay in entering command mode, as described by
# http://zsh.sourceforge.net/Guide/zshguide04.html:
#
# You can remove all bindings starting with a given prefix by adding the `-p
# option. The example given in the manual,
#     bindkey -rpM viins '\e'
# (except it uses the equivalent form `^[') is amongst the most useful, as it
# will remove the annoying delay after you type `\e' to enter vi command mode.
# The delay is there because the cursor keys usually also start with \e and
# the shell is waiting to see if you actually typed one of those.
# bindkey -rpM viins "\e"

# Use control+j and control+k for scrolling through history, since removing
# all bindings that begin with escape also removes the arrow-key bindings
bindkey "^K" history-substring-search-up
bindkey "^J" history-substring-search-down

# ^R: atuin fuzzy history search (was ^X^R via fzf)
command -v atuin &>/dev/null && bindkey '^R' atuin-search

# Press Ctrl+Q to push the current command on to the stack. It will disappear,
# allowing you to enter another command, after which it will reappear in the
# prompt.
bindkey "^Q" push-input

# Get the absolute path of a file
alias fullpath="readlink -f"
# Use colordiff instead of native diff
alias diff="colordiff"
# Always sudo htop (doesn't work properly on macOS otherwise)
if [[ "$OSTYPE" == darwin* ]]; then
  alias htop="sudo htop"
fi
# (l / ll / lsa are defined with the eza block below, which has a BSD ls fallback)
# Safe rm
alias t="trash"
# Clear screen
alias c="clear"
# Clear screen and list contents
alias cl="clear && l"
# Move up one directory
alias ..="cd .."
# Human-readable disk usage information
alias df="df -h"
# Forward port
alias forward="ssh -NL"
# mosh + tmux: connect to a host and attach-or-create a persistent tmux session
# named "main", so the session survives even if the mosh client dies (laptop
# reboot / app quit). All args pass through to mosh, so ~/.ssh/config aliases and
# flags work, e.g.  mosht myhost   or   mosht --ssh="ssh -p 2222" user@host
mosht() { mosh "$@" -- tmux new -A -s main; }
# Set up a fresh GPU box: runs remote/bootstrap.sh over ssh. The tokens go in
# on stdin with the script, so they never appear in the remote process list.
# All args pass through to ssh, e.g.  rboot -p 40022 root@1.2.3.4
rboot() {
  { for _k in HF_TOKEN WANDB_API_KEY; do
      [[ -n ${(P)_k} ]] && printf 'export %s=%q\n' $_k "${(P)_k}"
    done
    command cat "$DOTFILES/remote/bootstrap.sh"
  } | ssh "$@" bash -s
}

# Modern CLI tool replacements (2026)
# bat: cat with syntax highlighting and pager
if command -v bat &>/dev/null; then
  alias cat="bat"
  alias catp="bat --style=plain"  # plain cat without decorations
  alias less="bat --paging=always"
  export BAT_THEME="Catppuccin Mocha"
  export BAT_PAGER="less -RF"
  # Use bat for man pages with proper formatting
  export MANPAGER="sh -c 'col -bx | bat -l man -p'"
  export MANROFFOPT="-c"
fi
# eza: modern ls replacement
if command -v eza &>/dev/null; then
  alias ls="eza --color=auto --icons=auto"
  alias l="eza -la --icons=auto --git"
  alias ll="eza -l --icons=auto --git"
  alias lsa="eza -la --icons=auto"
  alias tree="eza --tree --icons=auto"
else
  alias ls="ls -GF"
  alias l="ls -AhG1F"
  alias ll="ls -lAhGF"
  alias lsa="ls -AhGF"
fi
# fd is installed and called as `fd`. Deliberately NOT aliased over `find`:
# their argument syntax is unrelated, so `find . -name '*.py'` fails under the
# alias, and anything that sources this file non-interactively (Claude Code's
# Bash tool, for one) inherits the breakage.
# dust is likewise called as `dust`, not aliased over `du`: `du -sh .` fails
# under the alias for the same reason.

# Editing shortcuts
alias v="vim"

# git aliases
alias gp="git push"
# git diff
alias gc="git commit -m"
# git diff
alias gd="git d"
# git diff
alias gdc="git dc"
# git log
alias gl="git l"
# git log all branches
alias gla="git la"
# git branch
alias gb="git branch"
# git branch delete
alias gbd="git branch -d"
# fast git status
alias g="git status"

# python
alias p="python3"
alias python="python3"

# claude. Remote Control is turned on for every session by
# `remoteControlAtStartup` in ~/.claude/settings.json, so `claude` itself is
# not aliased; an alias also changed `claude -p` and other scripted calls.
alias plan="claude --permission-mode plan"
alias onecommit="claude -p '/one-commit'"
alias commitchunks="claude -p '/logical-commits'"
alias fable="claude --model fable"
alias opus="claude --model opus"
alias sonnet="claude --model sonnet"
alias haiku="claude --model haiku"
dlrecent() { eza --sort=modified --reverse ~/Downloads/ | head -1 | xargs -I {} echo ~/Downloads/"{}"; }

# -----------------------------------------------------------------------------
# FINAL PATH ASSEMBLY
# -----------------------------------------------------------------------------
# Earlier initialization may have mutated PATH. We now construct the final PATH
# *once* so precedence is explicit and stable.
typeset -U path
path=(
  # Keep a venv that was already active when this shell started (a VS Code
  # terminal, a tmux pane); the fixed list below would otherwise drop it.
  ${VIRTUAL_ENV:+$VIRTUAL_ENV/bin}
  $HOME/bin
  $HOME/dotfiles/bin
  $HOME/.local/bin
  /opt/homebrew/bin
  /opt/homebrew/sbin
  $HOME/.asdf/shims
  "/Applications/Docker.app/Contents/Resources/bin"
  "/Applications/Visual Studio Code.app/Contents/Resources/app/bin"
  /opt/homebrew/opt/coreutils/libexec/gnubin
  /usr/bin /bin /usr/sbin /sbin
)
export PATH="${(j/:/)path}"
hash -r

# -----------------------------------------------------------------------------
# zshrc.local
# -----------------------------------------------------------------------------
# Put local, non-portable overrides here.
[ -f "$HOME/.zshrc.local" ] && source "$HOME/.zshrc.local"

# Activate starship prompt
eval "$(starship init zsh)"
